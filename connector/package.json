{
  "name": "lagos-brief-connector",
  "version": "1.1.0",
  "private": true,
  "description": "Paid remote MCP connector for Claude: Lagos listing marketing strategy and market briefs, pay per call via Paystack",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "admin": "node dist/src/admin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
