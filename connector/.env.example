# Public HTTPS origin of this service (used in connector and checkout links).
# On Render, leave empty to use RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=https://brief.example.com
NODE_ENV=production
PORT=3000
# SQLite file on a persistent volume
DATABASE_PATH=/data/connector.db
# Paystack secret key from Settings > API Keys & Webhooks (sk_live_... in production)
PAYSTACK_SECRET_KEY=sk_test_xxx
# Set to 1 when running behind a reverse proxy or platform load balancer
TRUST_PROXY=1
SUPPORT_EMAIL=support@example.com
# Optional: override credit packs (price_kobo = naira x 100)
# CREDIT_PACKS=[{"id":"single","name":"One strategy","credits":3,"price_kobo":1500000}]
