# Local development: `npm run dev` loads this file automatically.
# For a deployed service, set these in the host's environment instead (render.yaml does most of it).
PORT=3000
# Public HTTPS origin used in connector and checkout links, e.g. https://brief.example.com.
# Leave empty locally (http://localhost) and on Render (defaults to RENDER_EXTERNAL_URL).
PUBLIC_BASE_URL=
DATABASE_PATH=./data/connector.db
# Paystack secret key from Settings > API Keys & Webhooks (sk_test_... until you go live)
PAYSTACK_SECRET_KEY=sk_test_xxx
# Proxy hops in front of the app: 0 locally, 3 on Render (check the proxy_check log line)
TRUST_PROXY=0
SUPPORT_EMAIL=support@example.com
# Production mode requires an https PUBLIC_BASE_URL and a Paystack key:
# NODE_ENV=production
# Optional: override credit packs (price_kobo = naira x 100)
# CREDIT_PACKS=[{"id":"single","name":"One strategy","credits":3,"price_kobo":1500000}]
